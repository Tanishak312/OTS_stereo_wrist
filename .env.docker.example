# Copy to .env.docker for docker compose, or set these in the ECS task definition.
# Never add SUPABASE_SERVICE_ROLE, or any R2 key other than the preview one below.

# Required
SUPABASE_ANON_PUBLIC=
RESEND_API_KEY=
EMAIL_FROM=Awign Robotics Data <data@awign.in>
SAMPLE_DRIVE_URL_EGO=
OFFER_MCAP=true

# Optional. By default this comes from the anon key.
# SUPABASE_URL=https://<project>.supabase.co

# Optional. Environment-type preview videos at /api/preview/<slug>; off while any is empty.
# Its own R2 API token: Object Read only, scoped to the one bucket below. Never the
# write keys, never the shared read key, and never with a NEXT_PUBLIC_ prefix (that
# copies the value into the browser). The server streams the video; the browser
# never sees the endpoint, bucket, key or file paths.
# Final: the preview bucket (orion-sample-ots), files named <slug>.mp4.
# Local testing only: PREVIEW_R2_BUCKET=orion-awign-v1 serves the clips listed in
# data/preview-clips.json (gitignored, never deployed), and nothing without it.
# The S3 API address from the bucket's Settings page, not the dashboard link.
PREVIEW_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PREVIEW_R2_BUCKET=
PREVIEW_R2_ACCESS_KEY_ID=
PREVIEW_R2_SECRET_ACCESS_KEY=
